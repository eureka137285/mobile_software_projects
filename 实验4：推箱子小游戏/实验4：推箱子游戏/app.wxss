/*全局页面背景兜底*/
page{
  background: #CFEBD5;
}

/*页面容器样式*/
.container {
  min-height: 100vh;
  padding: 40rpx 0;
  color: #3E8E4E;
  font-weight: bold;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-evenly;
  box-sizing: border-box;
  background: linear-gradient(180deg, #EAF7EC 0%, #CFEBD5 100%);
}

/*顶端标题样式*/
.title{
  font-size: 18pt;
  letter-spacing: 2rpx;
}
