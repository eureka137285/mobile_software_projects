/* 搜索入口 */
.search-entry{
  display: flex;
  align-items: center;
  margin: 20rpx 20rpx 0;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(24, 83, 161, 0.08);
  box-sizing: border-box;
  transition: background-color 0.2s ease;
}

.search-entry-icon{
  font-size: 30rpx;
  margin-right: 14rpx;
}

.search-entry-text{
  font-size: 28rpx;
  color: #8aa0bb;
}

.search-entry-hover{
  background: #eef5ff;
}

swiper{
  height: 340rpx;
  width: 710rpx;
  margin: 20rpx 20rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 24rpx rgba(24, 83, 161, 0.08);
  animation: fadeIn 0.6s ease both;
}

swiper image{
  width: 100%;
  height: 100%;
  animation: kenBurns 6s ease-out both;
}

/* 轮播图配文：渐变遮罩 + 两行省略标题，避免遮挡主体内容 */
.swiper-slide{
  position: relative;
  width: 100%;
  height: 100%;
}

.swiper-slide > image{
  width: 100%;
  height: 100%;
}

.swiper-mask{
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 45%;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.55) 100%);
  pointer-events: none;
}

.swiper-title{
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 44rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-all;
}

.swiper-hover{
  opacity: 0.92;
}

/* 卡片与标题依次入场 */
.notice-card{
  animation: fadeInUp 0.5s ease both;
}

.section-title{
  animation: fadeInUp 0.5s ease 0.1s both;
}

.news-list{
  animation: fadeInUp 0.5s ease 0.15s both;
}

.notice-card--footer{
  animation: fadeInUp 0.5s ease 0.25s both;
}

/* 新闻条目：逐条错峰入场 + 按压反馈 */
.news-item{
  border-radius: 16rpx;
  transition: background-color 0.2s ease;
  animation: fadeInUp 0.45s ease both;
}
