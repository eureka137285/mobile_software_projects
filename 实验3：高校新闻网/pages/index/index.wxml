<view class="search-entry" hover-class="search-entry-hover" hover-stay-time="120" bindtap="goToSearch">
  <text class="search-entry-icon">🔍</text>
  <text class="search-entry-text">搜索新闻标题 / 正文内容</text>
</view>
<swiper indicator-dots="true" autoplay="true" interval="5000" duration="500">
  <swiper-item class="swiper-slide" wx:for="{{swiperImg}}" wx:key="id"
               hover-class="swiper-hover" hover-stay-time="120"
               bindtap="goToDetail" data-id="{{item.id}}">
    <image src="{{item.src}}" mode="aspectFill"></image>
    <view class="swiper-mask"></view>
    <view class="swiper-title">{{item.title}}</view>
  </swiper-item>
</swiper>
<view class="notice-card">
  <view class="notice-title">海大新闻速览</view>
  <view class="notice-text">当前展示最新 {{newsCount}} 条校园新闻，点击标题可进入正文阅读。</view>
</view>
<view class="section-title">最新新闻</view>
<view class="news-list">
  <view class="news-item" wx:for="{{newsList}}" wx:key="id"
        style="animation-delay: {{index * 60}}ms"
        hover-class="item-hover" hover-stay-time="120"
        bindtap="goToDetail" data-id="{{item.id}}">
    <image src="{{item.poster}}" mode="aspectFill"></image>
    <text>{{item.title}}——{{item.add_date}}</text>
  </view>
</view>
<view class="notice-card notice-card--footer">
  <view class="notice-title">精彩更新中</view>
  <view class="notice-text">更多校园动态持续更新中，收藏后可在“我的”页面快速查看。</view>
</view>
