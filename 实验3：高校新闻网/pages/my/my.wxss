.myLogin{
  margin: 20rpx 20rpx 0;
  padding: 36rpx 24rpx;
  background: linear-gradient(135deg, #328EEB 0%, #0b67d1 100%);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(50, 142, 235, 0.24);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-around;
  animation: fadeInUp 0.45s ease both;
}

.myLogin image{
  height: 200rpx;
  width: 200rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.75);
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.12);
}

.myLogin text{
  color: white;
  font-size: 32rpx;
  font-weight: 600;
}

.myLogin .avatar-wrapper{
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  margin: 0;
  padding: 0;
  min-width: 0;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.25);
  overflow: hidden;
}

.myLogin .avatar-wrapper .avatar{
  width: 100%;
  height: 100%;
  border: 0;
  box-shadow: none;
}

.myLogin .nick-input{
  width: 440rpx;
  height: 76rpx;
  margin-top: 24rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.95);
  font-size: 28rpx;
  color: #16345f;
  text-align: center;
}

.myLogin .login-hint{
  margin-top: 14rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
}

.myLogin .login-btn,
.myLogin .anon-btn{
  display: flex;
  align-items: center;
  justify-content: center;
  width: 360rpx;
  height: 84rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 1;
  letter-spacing: 2rpx;
  box-sizing: border-box;
}

.myLogin .login-btn{
  margin-top: 24rpx;
  color: #0b67d1;
  background: #fff;
  font-weight: 600;
}

.myLogin .anon-btn{
  margin-top: 16rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}

.myLogin button::after{
  border: 0;
}

.avatar-placeholder{
  display: flex;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  border: 6rpx solid rgba(255, 255, 255, 0.75);
  color: #fff;
  font-size: 80rpx;
}

.myLogin .login-type{
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.85);
}

.myLogin .logout-btn{
  margin-top: 20rpx;
  padding: 6rpx 28rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 999rpx;
}

.myFavorite{
  margin: 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(24, 83, 161, 0.08);
  box-sizing: border-box;
  animation: fadeInUp 0.5s ease 0.08s both;
}

.myFavorite .swipe-item{
  animation: fadeInUp 0.45s ease both;
}

.myLike{
  margin: 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(24, 83, 161, 0.08);
  box-sizing: border-box;
  animation: fadeInUp 0.5s ease 0.12s both;
}

.myLike > text{
  display: block;
  margin-bottom: 14rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #0b67d1;
}

.myLike .swipe-item{
  animation: fadeInUp 0.45s ease both;
}

.like-empty{
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8aa0bb;
}

.myFavorite > text{
  display: block;
  margin-bottom: 14rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #0b67d1;
}

.myHistory{
  margin: 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(24, 83, 161, 0.08);
  box-sizing: border-box;
  animation: fadeInUp 0.5s ease 0.16s both;
}

.history-header{
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.history-header > text:first-child{
  font-size: 32rpx;
  font-weight: 600;
  color: #0b67d1;
}

.clear-btn{
  font-size: 26rpx;
  color: #6f829a;
  padding: 6rpx 16rpx;
}

.news-info{
  flex: 1;
  min-width: 0;
  margin-right: 100rpx;
}

.news-item .news-title{
  font-size: 30rpx;
  color: #16345f;
}

.news-item .news-time{
  font-size: 24rpx;
  color: #8aa0bb;
}

.myHistory .news-item{
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f4fa;
}

.myHistory .news-item:last-child{
  border-bottom: 0;
}

.myHistory .news-item-main{
  display: flex;
  align-items: center;
  border-radius: 12rpx;
  transition: background-color 0.2s ease;
  animation: fadeInUp 0.45s ease both;
}

.myHistory .news-item-main > image{
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.myHistory .news-info{
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  margin-right: 0;
}

.myHistory .news-item .del-btn{
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 140rpx !important;
  height: 56rpx !important;
  min-width: 140rpx;
  margin: 16rpx 0 0 auto;
  padding: 0;
  font-size: 24rpx;
  color: #e05a5a;
  border: 1rpx solid rgba(224, 90, 90, 0.5);
  border-radius: 999rpx;
  background: #fff;
  line-height: 1;
  flex-shrink: 0;
}

.history-empty{
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8aa0bb;
}

/* ========== 收藏 / 点赞 左滑删除 ========== */
.swipe-item{
  position: relative;
  overflow: hidden;
}

.swipe-content{
  position: relative;
  z-index: 2;
  background: #fff;
  border-radius: 16rpx;
  transition: transform 0.25s ease, background-color 0.2s ease;
}

.swipe-content.slide-open{
  transform: translateX(-140rpx);
}

.swipe-del{
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e64340;
  color: #fff;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  border-radius: 0 16rpx 16rpx 0;
}
