.container{
  margin: 20rpx;
  padding: 32rpx 28rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(24, 83, 161, 0.08);
  animation: fadeInUp 0.5s ease both;
}

.title{
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.5;
  text-align: center;
  color: #0b67d1;
  animation: zoomIn 0.5s ease both;
}

.poster{
  margin-top: 20rpx;
  text-align: center;
}

.poster image{
  width: 700rpx;
  max-width: 100%;
  border-radius: 18rpx;
  animation: fadeIn 0.6s ease 0.08s both;
}

.content{
  margin-top: 30rpx;
  padding: 24rpx 10rpx 0;
}

.paragraph{
  font-size: 30rpx;
  line-height: 1.9;
  text-align: justify;
  text-indent: 2em;
  margin-bottom: 24rpx;
  color: #24364f;
  opacity: 0;
  animation: fadeInUp 0.45s ease both;
}

.paragraph:last-child{
  margin-bottom: 0;
}

.add_date{
  font-size: 30rpx;
  text-align: right;
  line-height: 30rpx;
  margin-right: 25rpx;
  margin-top: 20rpx;
  color: #6f829a;
  opacity: 0;
  animation: fadeIn 0.5s ease 0.1s both;
}

.action-bar{
  display: flex;
  justify-content: center;
  margin-top: 36rpx;
}

.action-bar button{
  display: flex;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  height: 84rpx;
  margin: 0 16rpx;
  padding: 0;
  border-radius: 999rpx;
  background: #328EEB;
  color: #fff;
  font-size: 30rpx;
  line-height: 1;
  letter-spacing: 2rpx;
  box-sizing: border-box;
  transition: transform 0.2s ease, opacity 0.2s ease;
  animation: fadeIn 0.5s ease 0.15s both;
}

.action-bar .like-btn{
  background: #ff8f1f;
}

button::after{
  border: 0;
}
