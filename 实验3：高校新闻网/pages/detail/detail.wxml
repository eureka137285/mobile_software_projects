<view class="container">
  <view class="title">{{article.title}}</view>
  <view class="poster">
    <image src="{{article.poster}}" mode="widthFix"></image>
  </view>
  <view class="content">
    <view class="paragraph" wx:for="{{paragraphs}}" wx:key="*this" style="animation-delay: {{index * 40}}ms">{{item}}</view>
  </view>
  <view class="add_date">{{article.add_date}}</view>
  <view class="action-bar">
    <button wx:if="{{isAdd}}" class="action-btn" hover-class="btn-hover" bindtap="cancelFavorites">❤️ 已收藏</button>
    <button wx:else class="action-btn" hover-class="btn-hover" bindtap="addFavorites">❤️ 收藏</button>
    <button wx:if="{{isLiked}}" class="action-btn like-btn" hover-class="btn-hover" bindtap="cancelLike">👍 已点赞</button>
    <button wx:else class="action-btn like-btn" hover-class="btn-hover" bindtap="addLike">👍 点赞</button>
  </view>
</view>
