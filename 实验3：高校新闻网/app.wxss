page{
  background: #f4f8ff;
  color: #16345f;
}

/* ========== 全局动画（跳转 / 入场） ========== */

/* 淡入上移：页面/卡片/列表项通用入场 */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 纯淡入 */
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* 缩放淡入：标题等强调元素 */
@keyframes zoomIn {
  from { opacity: 0; transform: scale(0.92); }
  to   { opacity: 1; transform: scale(1); }
}

/* 轮播图缓慢放大（Ken Burns 效果） */
@keyframes kenBurns {
  from { transform: scale(1); }
  to   { transform: scale(1.08); }
}

/* 点击按压反馈（配合 hover-class 使用） */
.item-hover{
  background: rgba(50, 142, 235, 0.08);
}

.btn-hover{
  transform: scale(0.96);
  opacity: 0.9;
}

.section-title{
  display: flex;
  align-items: center;
  margin: 24rpx 20rpx 14rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #0b67d1;
}

.section-title::before{
  content: '';
  width: 10rpx;
  height: 30rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #328EEB;
}

.notice-card{
  margin: 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #e8f3ff 0%, #ffffff 100%);
  border: 1rpx solid rgba(50, 142, 235, 0.16);
  border-left: 8rpx solid #328EEB;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(24, 83, 161, 0.08);
  box-sizing: border-box;
}

.notice-card--footer{
  margin-top: 0;
  margin-bottom: 28rpx;
}

.notice-title{
  font-size: 32rpx;
  font-weight: 600;
  color: #0b67d1;
}

.notice-text{
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #5f7088;
}

.news-list{
  margin: 0 20rpx 20rpx;
  padding: 8rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(24, 83, 161, 0.08);
  box-sizing: border-box;
}

.news-item{
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(50, 142, 235, 0.12);
}

.news-item:last-child{
  border-bottom: 0;
}

.news-item image{
  height: 136rpx;
  width: 216rpx;
  margin-right: 18rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.news-item text{
  display: block;
  padding-top: 4rpx;
  width: 100%;
  line-height: 1.7;
  font-size: 30rpx;
  color: #16345f;
}
