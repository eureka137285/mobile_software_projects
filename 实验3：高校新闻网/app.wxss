page{
  background: #f4f8ff;
  color: #16345f;
}

.section-title{
  display: flex;
  align-items: center;
  margin: 24rpx 20rpx 14rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #0b67d1;
}

.section-title::before{
  content: '';
  width: 10rpx;
  height: 30rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #328EEB;
}

.notice-card{
  margin: 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #e8f3ff 0%, #ffffff 100%);
  border: 1rpx solid rgba(50, 142, 235, 0.16);
  border-left: 8rpx solid #328EEB;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(24, 83, 161, 0.08);
  box-sizing: border-box;
}

.notice-card--footer{
  margin-top: 0;
  margin-bottom: 28rpx;
}

.notice-title{
  font-size: 32rpx;
  font-weight: 600;
  color: #0b67d1;
}

.notice-text{
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #5f7088;
}

.news-list{
  margin: 0 20rpx 20rpx;
  padding: 8rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(24, 83, 161, 0.08);
  box-sizing: border-box;
}

.news-item{
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(50, 142, 235, 0.12);
}

.news-item:last-child{
  border-bottom: 0;
}

.news-item image{
  height: 136rpx;
  width: 216rpx;
  margin-right: 18rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.news-item text{
  display: block;
  padding-top: 4rpx;
  width: 100%;
  line-height: 1.7;
  font-size: 30rpx;
  color: #16345f;
}
